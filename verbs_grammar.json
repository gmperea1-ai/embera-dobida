  "tenses": [
    {
      "id": "pres_cont",
      "name": "Presente Continuo (Haciendo ahora)",
      "suffix_singular": " ɓʉ",
      "suffix_plural": " panʉ",
      "formula": "Raíz + ɓʉ (singular) / panʉ (plural)",
      "explanation": "Expresa la acción que se está realizando en este preciso momento (Pág. 35 del manual)."
    },
    {
      "id": "pres_hab",
      "name": "Presente Habitual (Suele hacer)",
      "suffix_singular": "bari",
      "suffix_plural": "bada",
      "formula": "Raíz + bari (singular) / bada (plural)",
      "explanation": "Expresa una costumbre o acción repetitiva (ej. idibada = suelen preguntar)."
    },
    {
      "id": "past_simple",
      "name": "Pasado Simple (Hizo / Realizó)",
      "suffix_singular": "sia",
      "suffix_plural": "siɗaa",
      "formula": "Raíz + sia (singular) / siɗaa (plural)",
      "explanation": "Expresa una acción completada en el pasado (ej. cawasia = aprendió)."
    },
    {
      "id": "future_simple",
      "name": "Futuro Simple (Hará)",
      "suffix_singular": "ya",
      "suffix_plural": "dia",
      "formula": "Raíz + ya (singular) / dia o nia (plural)",
      "explanation": "Expresa lo que sucederá más adelante (ej. carebaya = ayudará)."
    },
    {
      "id": "imperative",
